ech COVID-19 Vaccine in Adolescents Aged 12\xe2\x80\x9315 Years \xe2\x80\x94 United States, May 2021</rdf:li>\n            </rdf:Alt>\n         </dc:title>\n         <dc:description>\n            <rdf:Alt>\n               <rdf:li xml:lang="x-default">In May 2021, after a systematic review of all available data,\xe2\x80\xafthe Advisory Committee on Immunization Practices made an interim recommendation for use of the Pfizer-BioNTech\xe2\x80\xafCOVID-19 vaccine in adolescents aged 12\xe2\x80\x9315 years for the prevention of COVID-19.</rdf:li>\n            </rdf:Alt>\n         </dc:description>\n         <dc:creator>\n            <rdf:Seq>\n               <rdf:li>Centers for Disease Control and Prevention</rdf:li>\n            </rdf:Seq>\n         </dc:creator>\n         <dc:subject>\n            <rdf:Bag>\n               <rdf:li>COVID-19 Vaccine Recommendation</rdf:li>\n               <rdf:li>\xe2\x80\xafAdvisory Committee on Immunization Practices Interim Recommendation</rdf:li>\n               <rdf:li>Pfizer-BioNTech\xe2\x80\xafCOVID-19 Vaccination</rdf:li>\n               <rdf:li>Pfizer-BioNTech\xe2\x80\xafCOVID-19 Vaccine In Persons Aged 12\xe2\x80\x9315 Years</rdf:li>\n               <rdf:li>May 2021.</rdf:li>\n            </rdf:Bag>\n         </dc:subject>\n         <xmpMM:DocumentID>uuid:25559648-075a-40f6-b40f-c49edce49c59</xmpMM:DocumentID>\n         <xmpMM:InstanceID>uuid:8e129d9e-b68e-4221-b1fa-ed5b45154af4</xmpMM:InstanceID>\n         <pdf:Producer>Adobe PDF Library 15.0</pdf:Producer>\n         <pdf:Keywords>COVID-19 Vaccine Recommendation; \xe2\x80\xafAdvisory Committee on Immunization Practices Interim Recommendation; Pfizer-BioNTech\xe2\x80\xafCOVID-19 Vaccination; Pfizer-BioNTech\xe2\x80\xafCOVID-19 Vaccine In Persons Aged 12\xe2\x80\x9315 Years; May 2021.</pdf:Keywords>\n         <pdf:Trapped>False</pdf:Trapped>\n         <illustrator:StartupProfile>Print</illustrator:StartupProfile>\n      </rdf:Description>\n   </rdf:RDF>\n</x:xmpmeta>\n           